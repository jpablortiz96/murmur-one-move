{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "murmur-one-move",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Open MURMUR test expedition",
        "description": "Create or reopen the active seven-day expedition",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onCommentDelete": "/internal/triggers/on-comment-delete",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scheduler": {
    "tasks": {
      "resolve-round": {
        "endpoint": "/internal/scheduler/resolve-round"
      },
      "publish-next-chapter": {
        "endpoint": "/internal/scheduler/publish-next-chapter"
      },
      "reconcile-expedition": {
        "endpoint": "/internal/scheduler/reconcile-expedition",
        "cron": "*/5 * * * *"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "murmur_one_move_dev"
  }
}
